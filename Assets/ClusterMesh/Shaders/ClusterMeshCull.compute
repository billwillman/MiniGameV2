#pragma kernel CullClusters
#pragma kernel CullStreamedClusters

#include "ClusterMeshBuffers.hlsl"

StructuredBuffer<ClusterHeader> _Clusters;
StructuredBuffer<ClusterGroup> _Groups;
StructuredBuffer<int> _OwningGroups;
AppendStructuredBuffer<uint> _VisibleClusterIds;
AppendStructuredBuffer<uint> _ShadowClusterIds;

uint _ClusterCount;
uint _GroupCount;
uint _ObjectCount;
uint _MaterialIndex;
int _IsolateIndex;
int _EnableConeCull;
int _EnableShadowList;
float4 _ShadowPlanes[6];
int _HierarchyVersion;
int _LodPerspective;
float _LodErrorThreshold;
float _LodProjectionScale;
float4 _Planes[6];
float3 _WorldCameraPos;
float4x4 _ObjectLocalToWorld[256];
StructuredBuffer<uint> _ObjectCameraCullFlags;


// Streaming-only data. CullClusters deliberately does not reference these so
// the legacy static-buffer kernel remains unchanged.
StructuredBuffer<ClusterStreamNode> _StreamNodes;
StructuredBuffer<ClusterStreamAddress> _StreamAddresses;
StructuredBuffer<ClusterMeshStreamPageTableEntry> _StreamPageTable;
StructuredBuffer<uint> _StreamNodeResident;
RWStructuredBuffer<uint> _StreamRequestedPages;
RWStructuredBuffer<uint> _StreamSelectedNodeStamps;
int _StreamNodeCount;
int _StreamRequestPriorityOffset;
int _StreamRequestEnabled;
int _StreamPageVertexCapacity;
int _StreamPageIndexCapacity;
int _ClusterStreamingEnabled;
uint _StreamSelectionStamp;
void TransformAabb(ClusterHeader h, float4x4 m, out float3 worldCenter, out float3 worldExtents)
{
    float3 c = h.aabbCenter.xyz;
    float3 e = h.aabbExtents.xyz;
    worldCenter = mul(m, float4(c, 1.0f)).xyz;
    float3 x = mul((float3x3)m, float3(e.x, 0, 0));
    float3 y = mul((float3x3)m, float3(0, e.y, 0));
    float3 z = mul((float3x3)m, float3(0, 0, e.z));
    worldExtents = abs(x) + abs(y) + abs(z);
}

bool TestAabb(float3 c, float3 e, bool shadow)
{
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float4 p = shadow ? _ShadowPlanes[i] : _Planes[i];
        float3 n = p.xyz;
        float r = e.x * abs(n.x) + e.y * abs(n.y) + e.z * abs(n.z);
        if (dot(n, c) + p.w + r < 0.0f)
            return false;
    }
    return true;
}

bool TestCone(ClusterHeader h, float4x4 m, float3 worldExtents)
{
    float cutoff = h.coneAxisCutoff.w;
    if (cutoff < 0.0f)
        return true;
    float3 apex = mul(m, float4(h.coneApex.xyz, 1.0f)).xyz;
    float3 axis = mul((float3x3)m, h.coneAxisCutoff.xyz);
    float axisLen = length(axis);
    if (axisLen < 1e-8f)
        return true;
    axis /= axisLen;
    float3 view = _WorldCameraPos - apex;
    float dist = length(view);
    if (dist < 1e-6f)
        return true;
    float radius = length(worldExtents);
    if (dist <= radius)
        return true;
    view /= dist;
    float cosA = saturate(cutoff);
    float sinA = sqrt(1.0f - cosA * cosA);
    float sinB = radius / dist;
    float cosB = sqrt(max(0.0f, 1.0f - sinB * sinB));
    float threshold = -(sinA * cosB + cosA * sinB);
    return dot(view, axis) >= threshold;
}

float MaxAxisScale(float4x4 m)
{
    float sx = length(mul((float3x3)m, float3(1, 0, 0)));
    float sy = length(mul((float3x3)m, float3(0, 1, 0)));
    float sz = length(mul((float3x3)m, float3(0, 0, 1)));
    return max(sx, max(sy, max(sz, 1e-6f)));
}

float LodProjected(float lodError, float3 worldCenter, float4x4 m)
{
    float e = lodError * MaxAxisScale(m) * _LodProjectionScale;
    if (_LodPerspective != 0)
    {
        float dist = max(length(_WorldCameraPos - worldCenter), 1e-4f);
        e /= dist;
    }
    return e;
}

uint LodLevel(uint flags)
{
    uint packed = (flags >> 8) & 255u;
    if (packed > 0u)
        return packed;
    return (flags & 1u) != 0u ? 1u : 0u;
}

int ReadOwningGroup(uint clusterIndex)
{
    int own = _OwningGroups[clusterIndex];
    if (own < 0 || (uint)own >= _GroupCount)
        return -1;
    return own;
}

bool TestLod(ClusterHeader h, float4x4 m, uint clusterIndex, int owningGroup)
{
    if (_HierarchyVersion < 1)
        return true;
    if (_LodErrorThreshold <= 0.0f)
        return LodLevel(h.flags) == 0u;
    if (_HierarchyVersion >= 2)
    {
        int own = owningGroup;
        if (own >= 0)
        {
            ClusterGroup g = _Groups[own];
            float3 gc = mul(m, float4(g.aabbCenter.xyz, 1.0f)).xyz;
            if (LodProjected(g.lodError, gc, m) >= _LodErrorThreshold)
                return false;
            if (g.parentGroupIndex < 0)
                return true;
            if ((uint)g.parentGroupIndex >= _GroupCount)
                return true;
            ClusterGroup pg = _Groups[g.parentGroupIndex];
            float3 pgc = mul(m, float4(pg.aabbCenter.xyz, 1.0f)).xyz;
            return LodProjected(pg.lodError, pgc, m) >= _LodErrorThreshold;
        }
        if (h.parentIndex < 0)
            return true;
        if ((uint)h.parentIndex >= _GroupCount)
            return true;
        ClusterGroup parent = _Groups[h.parentIndex];
        float3 pc = mul(m, float4(parent.aabbCenter.xyz, 1.0f)).xyz;
        return LodProjected(parent.lodError, pc, m) >= _LodErrorThreshold;
    }
    float3 wc, we;
    TransformAabb(h, m, wc, we);
    if (LodProjected(h.lodError, wc, m) >= _LodErrorThreshold)
        return false;
    if (h.parentIndex < 0)
        return true;
    if ((uint)h.parentIndex >= _ClusterCount)
        return true;
    ClusterHeader p = _Clusters[h.parentIndex];
    float3 pwc, pwe;
    TransformAabb(p, m, pwc, pwe);
    return LodProjected(p.lodError, pwc, m) >= _LodErrorThreshold;
}

[numthreads(64, 1, 1)]
void CullClusters(uint3 id : SV_DispatchThreadID)
{
    uint total = _ObjectCount * _ClusterCount;
    uint i = id.x;
    if (i >= total)
        return;
    uint objectIndex = i / _ClusterCount;
    uint clusterIndex = i % _ClusterCount;
    ClusterHeader h = _Clusters[clusterIndex];
    if (h.materialIndex != _MaterialIndex)
        return;
    if (_IsolateIndex >= 0 && (int)clusterIndex != _IsolateIndex)
        return;
    float3 wc, we;
    TransformAabb(h, _ObjectLocalToWorld[objectIndex], wc, we);
    bool inCamera = _ObjectCameraCullFlags[objectIndex] == 0u || TestAabb(wc, we, false);
    bool inShadow = _EnableShadowList != 0 && TestAabb(wc, we, true);
    if (!inCamera && !inShadow)
        return;
    int owningGroup = -1;
    if (_HierarchyVersion >= 2 && _LodErrorThreshold > 0.0f)
        owningGroup = ReadOwningGroup(clusterIndex);
    if (!TestLod(h, _ObjectLocalToWorld[objectIndex], clusterIndex, owningGroup))
        return;
    uint packed = (objectIndex << 16) | clusterIndex;
    if (inCamera)
    {
        bool useCone = _EnableConeCull != 0;
        if (useCone && _HierarchyVersion >= 2 && _LodErrorThreshold > 0.0f && owningGroup >= 0)
            useCone = false;
        if (!useCone || TestCone(h, _ObjectLocalToWorld[objectIndex], we))
            _VisibleClusterIds.Append(packed);
    }
    if (inShadow)
        _ShadowClusterIds.Append(packed);
}

void TransformStreamAabb(ClusterStreamNode node, float4x4 m, out float3 worldCenter, out float3 worldExtents)
{
    worldCenter = mul(m, float4(node.aabbCenter.xyz, 1.0f)).xyz;
    float3 e = node.aabbExtents.xyz;
    float3 x = mul((float3x3)m, float3(e.x, 0, 0));
    float3 y = mul((float3x3)m, float3(0, e.y, 0));
    float3 z = mul((float3x3)m, float3(0, 0, e.z));
    worldExtents = abs(x) + abs(y) + abs(z);
}

// This is the group-style branch of TestLod expressed over stream nodes. A
// node is selected at the point where it is sufficiently coarse but its parent
// is not, so exactly one desired node is chosen per hierarchy branch.
bool IsDesiredStreamNode(uint nodeIndex, float4x4 objectToWorld)
{
    ClusterStreamNode node = _StreamNodes[nodeIndex];
    if (_LodErrorThreshold <= 0.0f)
        return node.lodLevel == 0;

    float3 center, extents;
    TransformStreamAabb(node, objectToWorld, center, extents);
    if (LodProjected(node.lodError, center, objectToWorld) >= _LodErrorThreshold)
        return false;
    if (node.parentNodeIndex < 0 || node.parentNodeIndex >= _StreamNodeCount)
        return true;

    ClusterStreamNode parent = _StreamNodes[node.parentNodeIndex];
    float3 parentCenter, parentExtents;
    TransformStreamAabb(parent, objectToWorld, parentCenter, parentExtents);
    return LodProjected(parent.lodError, parentCenter, objectToWorld) >= _LodErrorThreshold;
}

bool FindResidentStreamNode(uint requestedNode, out uint selectedNode)
{
    int current = (int)requestedNode;
    int remaining = _StreamNodeCount;
    [loop]
    while (current >= 0 && current < _StreamNodeCount && remaining-- > 0)
    {
        if ((_StreamNodeResident[current] & 1u) != 0u)
        {
            selectedNode = (uint)current;
            return true;
        }
        current = _StreamNodes[current].parentNodeIndex;
    }
    selectedNode = 0;
    return false;
}

bool TrySelectStreamNode(uint objectIndex, uint nodeIndex)
{
    uint stampIndex = objectIndex * (uint)_StreamNodeCount + nodeIndex;
    uint previous;
    InterlockedExchange(_StreamSelectedNodeStamps[stampIndex], _StreamSelectionStamp, previous);
    return previous != _StreamSelectionStamp;
}

void AppendStreamNodeClusters(uint objectIndex, uint nodeIndex)
{
    ClusterStreamNode node = _StreamNodes[nodeIndex];
    uint start = (uint)max(node.clusterStart, 0);
    uint count = (uint)max(node.clusterCount, 0);
    uint end = min(start + count, _ClusterCount);
    float4x4 objectToWorld = _ObjectLocalToWorld[objectIndex];

    [loop]
    for (uint clusterIndex = start; clusterIndex < end; clusterIndex++)
    {
        ClusterHeader h = _Clusters[clusterIndex];
        if (h.materialIndex != _MaterialIndex)
            continue;
        if (_IsolateIndex >= 0 && (int)clusterIndex != _IsolateIndex)
            continue;

        float3 worldCenter, worldExtents;
        TransformAabb(h, objectToWorld, worldCenter, worldExtents);
        bool inCamera = _ObjectCameraCullFlags[objectIndex] == 0u || TestAabb(worldCenter, worldExtents, false);
        bool inShadow = _EnableShadowList != 0 && TestAabb(worldCenter, worldExtents, true);
        if (!inCamera && !inShadow)
            continue;

        int owningGroup = -1;
        if (_HierarchyVersion >= 2 && _LodErrorThreshold > 0.0f)
            owningGroup = ReadOwningGroup(clusterIndex);
        uint packed = (objectIndex << 16) | clusterIndex;
        if (inCamera)
        {
            bool useCone = _EnableConeCull != 0;
            if (useCone && _HierarchyVersion >= 2 && _LodErrorThreshold > 0.0f && owningGroup >= 0)
                useCone = false;
            if (!useCone || TestCone(h, objectToWorld, worldExtents))
                _VisibleClusterIds.Append(packed);
        }
        if (inShadow)
            _ShadowClusterIds.Append(packed);
    }
}

[numthreads(64, 1, 1)]
void CullStreamedClusters(uint3 id : SV_DispatchThreadID)
{
    if (_ClusterStreamingEnabled == 0 || _StreamNodeCount <= 0)
        return;

    uint total = _ObjectCount * (uint)_StreamNodeCount;
    uint i = id.x;
    if (i >= total)
        return;

    uint objectIndex = i / (uint)_StreamNodeCount;
    uint desiredNode = i % (uint)_StreamNodeCount;
    float3 requestCenter, requestExtents;
    TransformStreamAabb(_StreamNodes[desiredNode], _ObjectLocalToWorld[objectIndex], requestCenter, requestExtents);
    bool requestInCamera = _ObjectCameraCullFlags[objectIndex] == 0u ||
        TestAabb(requestCenter, requestExtents, false);
    bool requestInShadow = _EnableShadowList != 0 && TestAabb(requestCenter, requestExtents, true);
    if (!requestInCamera && !requestInShadow)
        return;
    if (!IsDesiredStreamNode(desiredNode, _ObjectLocalToWorld[objectIndex]))
        return;

    // This is also the residency-use signal. RequestNode refreshes the LRU age
    // when the page is already present and schedules I/O when it is not.
    if (_StreamRequestEnabled != 0)
    {
        uint ignored;
        uint requestWord = desiredNode >> 5;
        uint requestMask = 1u << (desiredNode & 31u);
        InterlockedOr(_StreamRequestedPages[requestWord], requestMask, ignored);
        float3 worldCenter = mul(_ObjectLocalToWorld[objectIndex], float4(_StreamNodes[desiredNode].aabbCenter.xyz, 1.0)).xyz;
        float distanceToCamera = length(worldCenter - _WorldCameraPos);
        uint priority = asuint(1.0 / max(1e-4, distanceToCamera));
        InterlockedMax(_StreamRequestedPages[_StreamRequestPriorityOffset + desiredNode], priority, ignored);
    }

    uint selectedNode = desiredNode;
    if ((_StreamNodeResident[desiredNode] & 1u) == 0u)
    {
        if (!FindResidentStreamNode(desiredNode, selectedNode))
            return;
        if (selectedNode != desiredNode && _StreamRequestEnabled != 0)
        {
            uint fallbackIgnored;
            InterlockedOr(
                _StreamRequestedPages[selectedNode >> 5],
                1u << (selectedNode & 31u),
                fallbackIgnored);
        }
    }
    if (!TrySelectStreamNode(objectIndex, selectedNode))
        return;
    AppendStreamNodeClusters(objectIndex, selectedNode);
}
